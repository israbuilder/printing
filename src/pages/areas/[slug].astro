---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ScheduleButton from "../../components/ScheduleButton.astro";
import { business } from "../../data/business";
import { areas, type Area } from "../../data/areas";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  return areas.map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

interface Props {
  area: Area;
}
const { area } = Astro.props;

const allServices = await getCollection("services");
const topServiceEntries = area.topServices
  .map((slug) => allServices.find((s) => s.id === slug))
  .filter(Boolean);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: business.url },
    { "@type": "ListItem", position: 2, name: "Areas We Serve", item: `${business.url}/areas-we-serve` },
    { "@type": "ListItem", position: 3, name: area.name, item: `${business.url}/areas/${area.slug}` },
  ],
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: `${business.name} - ${area.name}`,
  telephone: business.phone,
  url: `${business.url}/areas/${area.slug}`,
  areaServed: area.name,
};
---
<BaseLayout
  title={area.seoTitle}
  description={area.metaDescription}
  path={`/areas/${area.slug}`}
  jsonLd={[breadcrumbSchema, localBusinessSchema]}
>
  <!-- Hero Section -->
  <section class="bg-navy text-white border-b-4 border-brass">
    <div class="max-w-4xl mx-auto px-6 py-14">
      <nav aria-label="Breadcrumb" class="mb-4">
        <ol class="flex items-center gap-2 text-xs font-semibold text-white/70">
          <li><a href="/" class="hover:text-brass-light">Home</a></li>
          <li>/</li>
          <li><a href="/areas-we-serve" class="hover:text-brass-light">Areas We Serve</a></li>
          <li>/</li>
          <li class="text-brass-light">{area.name}</li>
        </ol>
      </nav>
      <span class="font-display font-bold text-brass-light text-sm uppercase tracking-widest">{area.heroEyebrow}</span>
      <h1 class="hp-rise mt-3 font-display font-black text-3xl sm:text-5xl leading-tight">{area.h1}</h1>
      <div class="mt-7 flex flex-wrap gap-4">
        <ScheduleButton class="px-7 py-3.5 text-lg" label="Get Free Quote" />
        <a href={business.phoneHref} class="hp-lift inline-flex items-center gap-2 border-2 border-brass text-brass-light hover:bg-brass hover:text-navy px-7 py-3.5 rounded-lg font-display font-bold text-lg transition-colors">
          Call {business.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- Area Overview -->
  <section class="max-w-4xl mx-auto px-6 py-14">
    <div class="space-y-6 text-navy/85 text-lg leading-relaxed">
      {area.intro.map((p) => <p>{p}</p>)}
    </div>

    <!-- Local Print Focus -->
    <div class="mt-12 bg-white rounded-2xl border border-navy/10 p-8 shadow-sm">
      <h2 class="font-display font-bold text-2xl text-navy">Custom Print Needs in {area.name}</h2>
      <p class="mt-4 text-navy/75 leading-relaxed">{area.localChallenges}</p>
    </div>

    <!-- Top Services in this area -->
    <div class="mt-14">
      <h2 class="font-display font-bold text-2xl text-navy mb-6">Popular Print Services for {area.name}</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {topServiceEntries.map((s) => s && (
          <a href={`/services/${s.id}`} class="hp-lift block bg-white border border-navy/10 rounded-xl p-5 shadow-sm hover:border-brass/40 hover:shadow-md">
            <h3 class="font-display font-bold text-lg text-navy">{s.data.h1}</h3>
            <p class="mt-2 text-sm text-navy/65 line-clamp-2">{s.data.summary}</p>
            <span class="mt-3 font-display font-bold text-water text-xs inline-block">Learn more →</span>
          </a>
        ))}
      </div>
    </div>

    <!-- ZIP codes covered -->
    <div class="mt-12 bg-cream rounded-xl p-6 border border-navy/10">
      <h3 class="font-display font-bold text-navy text-sm uppercase tracking-wider mb-3">ZIP Codes Covered in {area.name}</h3>
      <div class="flex flex-wrap gap-2">
        {area.zips.map((z) => (
          <span class="bg-white border border-navy/15 rounded-md px-3 py-1 text-sm font-semibold text-navy">{z}</span>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-14 bg-navy text-white rounded-2xl p-8 text-center shadow-lg">
      <h2 class="font-display font-black text-2xl sm:text-3xl">Need Custom Printing in {area.name}?</h2>
      <p class="mt-2 text-white/80 max-w-xl mx-auto">Call {business.phone} or request a free quote online. Fast local turnaround and delivery.</p>
      <div class="mt-6 flex justify-center"><ScheduleButton class="px-8 py-4 text-lg" label="Request Quote Now" /></div>
    </div>
  </section>
</BaseLayout>
