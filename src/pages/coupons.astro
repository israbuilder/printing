---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScheduleButton from "../components/ScheduleButton.astro";
import { business } from "../data/business";

const fine = "Cannot be combined with other offers. Mention coupon when requesting your quote or placing your order. One coupon per order.";
const coupons = [
  { amount: "$25.00 OFF", title: "Custom Apparel Order", detail: "Valid on orders of 24+ custom t-shirts, hoodies, or uniforms." },
  { amount: "$50.00 OFF", title: "Bulk Sublimation Order", detail: "Valid on orders of 50+ sublimated tumblers, mugs, or gift items." },
  { amount: "$75.00 OFF", title: "Large Format Banners & Signs", detail: "Valid on banner, yard sign packages, or trade show displays over $300." },
  { amount: "FREE SETUP", title: "Artwork & Digitizing", detail: "Free artwork check and vector formatting on any order over $150." },
];
---
<BaseLayout
  title={`Printing Specials & Coupons | ${business.name}`}
  description={`Exclusive print discounts and coupons from ${business.name} in Houston, TX — savings on custom shirts, sublimation tumblers, banners, and marketing materials.`}
  path="/coupons"
>
  <!-- Banner -->
  <section class="bg-navy text-white border-b-4 border-brass">
    <div class="max-w-5xl mx-auto px-6 py-8 sm:py-14">
      <p class="font-display font-bold text-brass-light uppercase tracking-[0.2em] text-sm">Special Deals for Houston</p>
      <h1 class="hp-rise mt-2 font-display font-black text-3xl sm:text-5xl">Unlock Exclusive Print Coupons!</h1>
    </div>
  </section>

  <section class="px-6 py-6 sm:py-16 max-w-5xl mx-auto">
    <div id="coupon-wrap" class="relative" data-locked>
      <p id="coupon-msg" role="status" aria-live="polite" class="hidden mb-6 text-center font-display font-bold text-lg"></p>
      <div id="coupon-grid" class="grid gap-8 sm:grid-cols-2">
        {coupons.map((c) => (
          <div class="hp-lift relative flex flex-col bg-white rounded-2xl shadow-lg border-2 border-dashed border-brass overflow-hidden">
            <div class="flex-1 p-8 text-center">
              <span class="inline-block bg-flame text-white font-display font-bold text-xs uppercase tracking-[0.2em] px-3 py-1 rounded-full">Print Coupon</span>
              <p class="mt-4 font-display font-black text-4xl sm:text-5xl text-navy">{c.amount}</p>
              <h2 class="mt-3 font-display font-extrabold text-xl text-navy">{c.title}</h2>
              <p class="mt-2 text-navy/70">{c.detail}</p>
            </div>

            <div class="px-8 pb-8">
              <ScheduleButton class="w-full px-8 py-4 text-lg" label="Claim & Request Quote" />
              <p class="mt-3 flex items-center justify-center gap-1.5 text-sm font-bold text-navy/60">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
                Screenshot your coupon and save it
              </p>
              <p class="mt-4 text-xs text-navy/45 italic leading-relaxed text-center">{fine}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Capture gate -->
      <div id="coupon-gate" class="absolute inset-0 z-10 flex items-start justify-center px-2 pt-2 sm:pt-14">
        <div class="w-full max-w-md bg-white rounded-2xl shadow-2xl border-2 border-brass p-6 sm:p-8">
          <h2 class="font-display font-extrabold text-2xl text-navy text-center">Unlock Your Exclusive Print Coupons</h2>
          <p class="mt-2 text-navy/70 text-center text-sm">
            Sent straight to your mobile number in seconds.
          </p>
          <form id="coupon-form" class="mt-5 grid gap-4" data-phone={business.phone}>
            <div class="grid gap-1">
              <label for="cl-name" class="font-display font-semibold text-sm text-navy">Name</label>
              <input
                id="cl-name"
                name="name"
                required
                autocomplete="name"
                placeholder="Your name"
                class="border border-navy/20 bg-white px-3 py-2.5 rounded-lg text-navy focus:outline-none focus:ring-2 focus:ring-water focus:border-water transition"
              />
            </div>
            <div class="grid gap-1">
              <label for="cl-phone" class="font-display font-semibold text-sm text-navy">Mobile number</label>
              <input
                id="cl-phone"
                name="phone"
                type="tel"
                required
                autocomplete="tel"
                placeholder="(713) 555-0100"
                class="border border-navy/20 bg-white px-3 py-2.5 rounded-lg text-navy focus:outline-none focus:ring-2 focus:ring-water focus:border-water transition"
              />
            </div>
            <button
              type="submit"
              id="cl-submit"
              class="hp-lift mt-1 bg-flame hover:bg-brass-dark text-white px-5 py-3 rounded-lg font-display font-bold tracking-tight shadow-lg shadow-flame/25 transition-colors disabled:opacity-60 disabled:cursor-not-allowed disabled:shadow-none"
            >
              Unlock My Coupons
            </button>
            <p class="text-[11px] leading-relaxed text-navy/50 text-center">
              By submitting, you agree to receive a text with your coupons.
            </p>
          </form>
          <p id="cl-status" role="status" aria-live="polite" class="mt-2 text-sm text-center"></p>
        </div>
      </div>
    </div>

    <p class="mt-10 text-center text-navy/70">
      Questions? Call
      <a href={business.phoneHref} class="font-bold text-water hover:text-navy transition-colors">{business.phone}</a>
      and mention your coupon when you order.
    </p>
  </section>

  <style>
    #coupon-wrap[data-locked] #coupon-grid {
      filter: blur(10px);
      pointer-events: none;
      user-select: none;
    }
    #coupon-grid {
      transition: filter 0.5s ease;
    }
    #coupon-wrap:not([data-locked]) #coupon-gate {
      display: none;
    }
  </style>

  <script is:inline>
    try {
      if (localStorage.getItem("hp_coupons_unlocked") === "1") {
        document.getElementById("coupon-wrap").removeAttribute("data-locked");
      }
    } catch (e) {}
  </script>

  <script>
    const wrap = document.getElementById("coupon-wrap");
    const gate = document.getElementById("coupon-gate");
    const form = document.getElementById("coupon-form") as HTMLFormElement | null;
    const status = document.getElementById("cl-status");
    const msg = document.getElementById("coupon-msg");
    const submit = document.getElementById("cl-submit") as HTMLButtonElement | null;

    const leadSource = (): string => {
      try {
        const m = document.cookie.match(/(?:^|; )hp_attrib=([^;]+)/);
        if (!m) return "direct / none";
        const a = JSON.parse(decodeURIComponent(m[1]));
        const parts = [a.src || "?", a.med || "?"];
        if (a.camp) parts.push(a.camp);
        if (a.cont) parts.push(a.cont);
        let s = parts.join(" / ");
        if (a.lp) s += ` — landed ${a.lp}`;
        if (a.d) s += ` on ${a.d}`;
        return s;
      } catch {
        return "unknown";
      }
    };

    const unlock = () => {
      wrap?.removeAttribute("data-locked");
    };

    const showMsg = (text: string, colorClass: string) => {
      if (!msg) return;
      msg.textContent = text;
      msg.className = `mb-6 text-center font-display font-bold text-lg ${colorClass}`;
    };

    if (wrap && gate && form && status && submit) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const phoneDigits = (
          (form.elements.namedItem("phone") as HTMLInputElement)?.value ?? ""
        ).replace(/\D/g, "");
        const national =
          phoneDigits.length === 11 && phoneDigits.startsWith("1")
            ? phoneDigits.slice(1)
            : phoneDigits;
        if (national.length !== 10) {
          status.textContent = "Please double-check your mobile number.";
          status.className = "mt-2 text-sm text-center text-red-700 font-medium";
          return;
        }

        submit.disabled = true;
        status.textContent = "Unlocking your coupons…";
        status.className = "mt-2 text-sm text-center text-gray-600";

        try {
          const netlifyBody = new URLSearchParams();
          netlifyBody.append("form-name", "coupon-lead");
          for (const [k, v] of new FormData(form).entries()) {
            netlifyBody.append(k, typeof v === "string" ? v : "");
          }
          netlifyBody.append("lead_source", leadSource());
          fetch("/", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: netlifyBody.toString(),
          }).catch(() => {});
        } catch {}

        try {
          const body = new FormData(form);
          body.append("lead_source", leadSource());
          const res = await fetch("/api/coupon-lead", { method: "POST", body });
          const data = await res.json().catch(() => ({}));

          if (res.ok && data.ok) {
            try {
              localStorage.setItem("hp_coupons_unlocked", "1");
            } catch {}
            showMsg("📲 Sent! Check your texts for confirmation.", "text-green-700");
            unlock();
          } else if (res.status === 400) {
            submit.disabled = false;
            status.textContent = "Please double-check your name and mobile number.";
            status.className = "mt-2 text-sm text-center text-red-700 font-medium";
          } else {
            showMsg("Screenshot your coupons below to redeem.", "text-navy/70");
            unlock();
          }
        } catch {
          showMsg("Screenshot your coupons below to redeem.", "text-navy/70");
          unlock();
        }
      });
    }
  </script>
</BaseLayout>
