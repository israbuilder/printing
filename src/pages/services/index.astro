---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ScheduleButton from "../../components/ScheduleButton.astro";
import { business } from "../../data/business";

const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order
);
---
<BaseLayout
  title={`Custom Printing Services in Houston, TX | ${business.name}`}
  description={`Explore our full range of custom printing & sublimation services: DTF apparel, custom shirts, sublimated tumblers & mugs, banners, stickers, business cards, and vehicle graphics.`}
  path="/services"
>
  <!-- Banner -->
  <section class="bg-navy text-white border-b-4 border-brass">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <p class="font-display font-bold text-brass-light uppercase tracking-[0.2em] text-sm">Our Capabilities</p>
      <h1 class="hp-rise mt-3 font-display font-black text-4xl sm:text-5xl">Houston Custom Printing &amp; Sublimation Services</h1>
      <p class="mt-3 text-white/80 text-lg max-w-2xl">
        From single custom items and personalized gifts to large-scale commercial marketing and fleet graphics, our Houston print studio delivers unmatched quality and fast turnaround.
      </p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {services.map((svc) => (
        <a href={`/services/${svc.id}`} class="hp-lift group bg-white rounded-2xl border border-navy/10 shadow-sm hover:shadow-xl p-6 flex flex-col">
          <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-navy text-brass-light mb-4">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
          </span>
          <h2 class="font-display font-bold text-xl text-navy group-hover:text-water transition-colors">{svc.data.h1}</h2>
          <p class="mt-2 text-sm text-navy/70 flex-1 leading-relaxed">{svc.data.summary}</p>
          <span class="mt-4 font-display font-bold text-water text-sm inline-flex items-center gap-1">
            View service details →
          </span>
        </a>
      ))}
    </div>

    <div class="mt-14 bg-cream border border-navy/10 rounded-3xl p-8 sm:p-10 text-center shadow-sm">
      <h2 class="font-display font-black text-2xl sm:text-3xl text-navy">Need a Custom Project or Bulk Quote?</h2>
      <p class="mt-2 text-navy/70 max-w-xl mx-auto">
        Have unique artwork, special sizing, or custom substrates in mind? We're always happy to help. Call {business.phone} or request a free quote online.
      </p>
      <div class="mt-6 flex flex-col sm:flex-row justify-center items-center gap-4">
        <a
          href={business.phoneHref}
          class="hp-lift inline-flex items-center justify-center gap-2 rounded-xl bg-navy px-7 py-3.5 font-display text-base font-bold text-white shadow-md hover:bg-navy-700 transition-colors"
        >
          Call {business.phone}
        </a>
        <ScheduleButton class="px-7 py-3.5" label="Request Quote" />
      </div>
    </div>
  </section>
</BaseLayout>
