---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScheduleButton from "../components/ScheduleButton.astro";
import { business } from "../data/business";
---
<BaseLayout
  title={`Our Mission & Community | ${business.name}`}
  description={`${business.name} is dedicated to supporting the Greater Houston community, partnering with local schools, nonprofits, youth sports, and small businesses.`}
  path="/community-mission"
>
  <!-- Hero Section -->
  <section class="relative isolate overflow-hidden bg-navy-800 text-white">
    <div class="max-w-6xl mx-auto px-6 py-20 lg:py-28 text-center">
      <p class="font-display font-bold text-brass-light uppercase tracking-[0.2em] text-sm">
        Community Commitment
      </p>
      <h1 class="hp-rise mt-4 font-display font-black text-4xl sm:text-5xl lg:text-6xl max-w-3xl mx-auto leading-tight">
        Proudly Supporting Our Houston Community
      </h1>
      <p class="mt-6 text-white/80 text-lg sm:text-xl max-w-2xl mx-auto">
        Beyond printing custom shirts and banners, we believe in uplifting local Houston businesses, youth athletics, educational programs, and nonprofit charities.
      </p>
      <div class="mt-8 flex justify-center gap-4">
        <a
          href="/contact"
          class="hp-lift inline-flex items-center justify-center bg-water hover:bg-water-light text-white px-8 py-3.5 rounded-lg font-display font-bold transition-colors"
        >
          Partner With Us
        </a>
        <ScheduleButton class="px-8 py-3.5" label="Request Quote" />
      </div>
    </div>
  </section>

  <!-- Pillars Section -->
  <section class="py-20 px-6 max-w-6xl mx-auto">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="font-display font-bold text-3xl sm:text-4xl text-navy">
        Our Three Core Community Pillars
      </h2>
      <p class="mt-4 text-navy/70 text-lg">
        How {business.name} makes a positive local impact every single day across Greater Houston.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-3">
      <div class="bg-white rounded-2xl p-8 shadow-sm border border-navy/10 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-water/10 flex items-center justify-center text-water font-bold text-2xl mb-6">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
          </div>
          <h3 class="font-display font-bold text-xl text-navy">Eco-Conscious Inks</h3>
          <p class="mt-3 text-navy/75 leading-relaxed">
            We utilize water-based OEKO-TEX certified DTF inks, non-toxic sublimation dyes, and recyclable substrates to minimize environmental footprint.
          </p>
        </div>
      </div>

      <div class="bg-white rounded-2xl p-8 shadow-sm border border-navy/10 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-brass/10 flex items-center justify-center text-brass font-bold text-2xl mb-6">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3 class="font-display font-bold text-xl text-navy">Youth &amp; School Support</h3>
          <p class="mt-3 text-navy/75 leading-relaxed">
            We offer discounted spirit wear and sponsorship packages for Houston youth athletic teams, school booster clubs, and graduation fundraisers.
          </p>
        </div>
      </div>

      <div class="bg-white rounded-2xl p-8 shadow-sm border border-navy/10 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-flame/10 flex items-center justify-center text-flame font-bold text-2xl mb-6">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <h3 class="font-display font-bold text-xl text-navy">Small Business Advocacy</h3>
          <p class="mt-3 text-navy/75 leading-relaxed">
            We empower new Houston entrepreneurs and food trucks with zero-minimum startup apparel packages, signage, and marketing collateral.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-navy text-white py-16 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="font-display font-extrabold text-3xl sm:text-4xl">
        Looking for a Print Partner for Your Cause or Event?
      </h2>
      <p class="mt-4 text-white/80 text-lg">
        Call us today at <a href={business.phoneHref} class="font-bold text-brass-light hover:underline">{business.phone}</a> or send us a message online.
      </p>
      <div class="mt-8 flex justify-center">
        <ScheduleButton class="px-8 py-4 text-lg" label="Get in Touch" />
      </div>
    </div>
  </section>
</BaseLayout>
