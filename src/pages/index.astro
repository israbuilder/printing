---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScheduleButton from "../components/ScheduleButton.astro";
import { business } from "../data/business";
import { getCollection } from "astro:content";
import Reviews from "../components/Reviews.astro";
import { getPosts, formatPostDate } from "../lib/blog-api";

// Core services highlights
const services = [
  {
    title: "Custom T-Shirts & DTF",
    desc: "Vibrant, durable Direct-to-Film (DTF) apparel printing, hoodies, team jerseys, and uniforms with no color limits and zero minimums.",
    accent: "water",
    icon: "shirt",
    link: "/services/custom-t-shirts-and-apparel",
  },
  {
    title: "Sublimation & Gifts",
    desc: "Permanent, scratch-proof dye-sublimation on stainless steel tumblers, ceramic mugs, mousepads, keychains, and photo panels.",
    accent: "brass",
    icon: "gift",
    link: "/services/sublimation-products",
  },
  {
    title: "Banners, Signs & Decals",
    desc: "Heavy-duty outdoor vinyl banners, yard signs, die-cut stickers, and vehicle graphics built to resist Texas sun and weather.",
    accent: "flame",
    icon: "banner",
    link: "/services/banners-and-signs",
  },
];

const painPoints = [
  "Looking for a local print shop with fast turnaround and fair rates?",
  "Tired of low-quality prints that crack or fade after just two washes?",
  "Need full-color custom shirts without paying crazy setup fees or huge minimums?",
  "Looking for personalized sublimation tumblers, mugs, or corporate gifts?",
  "Need urgent trade show banners, yard signs, or vehicle graphics in Houston?",
  "Need help formatting or optimizing your artwork for high-resolution printing?",
];

const stats = [
  {
    type: "rating",
    link: "https://albranprinting.com",
    title: `${business.rating.count}+`,
    label: `${business.rating.value}★ Google Reviews`,
  },
  {
    type: "years",
    link: "/about",
    title: business.yearsTrusted,
    label: "Years Serving Houston",
  },
  {
    type: "licensed",
    link: "/services",
    title: "Zero Min",
    label: "On DTF & Sublimation",
  },
  {
    type: "bbb",
    link: "/coupons",
    title: "100%",
    label: "Satisfaction Guaranteed",
  },
];

const projects = [
  { src: "/images/placeholder.jpeg", alt: "Custom DTF printed t-shirts and hoodies" },
  { src: "/images/placeholder.jpeg", alt: "Custom sublimated stainless steel tumblers and mugs" },
  { src: "/images/placeholder.jpeg", alt: "Large format outdoor vinyl banner printing" },
  { src: "/images/placeholder.jpeg", alt: "Die-cut vinyl stickers and business stationery" },
];

// Fetch featured posts dynamically from the Headless CMS API
const postsResponse = await getPosts({ per_page: 3, page: 1 });
const featuredPosts = postsResponse.data || [];

const serviceLinks = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order
);
---
<BaseLayout
  title={`Custom Printing & Sublimation in Houston, TX | ${business.name}`}
  description={`Premier custom printing & sublimation in Houston, TX. High-definition DTF custom t-shirts, sublimated tumblers, banners, stickers & commercial printing. Call ${business.phone}.`}
  path="/"
  includeReviews={true}
>
  <!-- Hero Section (Replicated from reference layout) -->
  <section class="relative isolate overflow-hidden bg-white text-navy">
    <!-- Mobile hero image banner -->
    <div class="relative h-[280px] overflow-hidden sm:h-[360px] lg:hidden">
      <img
        src="/images/hero.jpg"
        alt={`${business.name} service vehicle serving Houston, TX`}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="900"
        height="700"
        class="absolute inset-0 h-full w-full object-cover object-left"
      />
      <div class="absolute inset-0"></div>
    </div>

    <!-- Desktop hero image background -->
    <div class="absolute inset-0 -z-30 hidden lg:block overflow-hidden">
      <img
        src="/images/hero.jpg"
        sizes="100vw"
        alt={`${business.name} service vehicle serving Houston, TX`}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="1920"
        height="1440"
        class="h-full w-full object-cover object-right translate-x-[12%] xl:translate-x-[15%]"
      />
    </div>

    <!-- Call Button floating over the vehicle - Desktop only -->
    <a
      href={business.phoneHref}
      class="hp-lift absolute right-[18%] top-[84%] z-20 hidden items-center justify-center gap-3 rounded-xl border-2 border-white bg-brass px-7 py-4 font-display text-lg font-black text-white shadow-xl transition-all duration-300 hover:scale-105 hover:bg-white hover:text-navy lg:inline-flex"
    >
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path
          d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
        />
      </svg>
      Call {business.phone}
    </a>

    <!-- Gradient overlays on desktop for text legibility -->
    <div
      class="absolute inset-y-0 left-0 -z-20 hidden w-[68%] bg-gradient-to-r from-white from-0% via-white/95 via-55% to-transparent to-100% lg:block"
    ></div>
    <div
      class="absolute inset-0 -z-20 hidden bg-gradient-to-t from-white/40 via-transparent to-transparent lg:block"
    ></div>

    <div class="relative mx-auto max-w-7xl px-5 pb-14 pt-2 sm:px-6 sm:pb-16 lg:flex lg:min-h-[680px] lg:items-center lg:px-6">
      <div class="max-w-xl lg:max-w-2xl">
        <h1
          class="hp-rise hp-delay-2 mt-3 font-display text-[2.45rem] font-black leading-[1.02] tracking-tight text-navy sm:text-5xl lg:mt-6 lg:max-w-2xl lg:text-6xl"
        >
          More Than Printing in Houston.
          <span class="text-brass block">Building a Better Brand.</span>
        </h1>

        <p class="hp-rise hp-delay-3 mt-4 max-w-xl font-display text-lg font-semibold leading-relaxed text-navy/85 sm:text-xl lg:mt-5">
          At {business.name}, we believe printing is about more than paper and ink. It’s about people, businesses, and creating lasting impressions that inspire.
        </p>

        <!-- MISSION HIGHLIGHTS -->
        <div class="hp-rise hp-delay-4 mt-7 grid grid-cols-3 gap-0 py-5 sm:max-w-xl">
          <!-- CUSTOM APPAREL -->
          <div class="px-3 text-center sm:px-5">
            <div class="mb-2 flex justify-center text-water">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/>
              </svg>
            </div>
            <h3 class="font-display text-sm font-black uppercase leading-tight text-navy sm:text-base">
              Custom<br />Apparel
            </h3>
            <p class="mt-2 text-[11px] font-bold leading-4 text-navy/70 sm:text-xs sm:leading-5">
              Retail-grade DTF prints with vivid colors that never fade or peel.
            </p>
          </div>

          <!-- VIBRANT SUBLIMATION -->
          <div class="border-x border-navy/10 px-3 text-center sm:px-5">
            <div class="mb-2 flex justify-center text-brass">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
              </svg>
            </div>
            <h3 class="font-display text-sm font-black uppercase leading-tight text-navy sm:text-base">
              Vibrant<br />Sublimation
            </h3>
            <p class="mt-2 text-[11px] font-bold leading-4 text-navy/70 sm:text-xs sm:leading-5">
              Full-color permanent drinkware, tumblers, and promotional items.
            </p>
          </div>

          <!-- LASTING IMPACT -->
          <div class="px-3 text-center sm:px-5">
            <div class="mb-2 flex justify-center text-flame">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            </div>
            <h3 class="font-display text-sm font-black uppercase leading-tight text-navy sm:text-base">
              Lasting<br />Impact
            </h3>
            <p class="mt-2 text-[11px] font-bold leading-4 text-navy/70 sm:text-xs sm:leading-5">
              Every custom print helps elevate local businesses and communities.
            </p>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="hp-rise hp-delay-5 mt-7 grid grid-cols-1 gap-3 sm:flex sm:flex-row sm:items-center lg:mt-8">
          <a
            href="/community-mission"
            class="hp-lift inline-flex w-full items-center justify-center gap-3 rounded-lg border-2 border-white bg-navy px-8 py-4 font-display text-lg font-bold text-white shadow-md shadow-navy/15 transition-all duration-300 hover:border-navy hover:bg-white hover:text-navy sm:w-auto"
          >
            LEARN ABOUT OUR MISSION
          </a>
          <a
            href={business.phoneHref}
            class="hp-lift inline-flex w-full items-center justify-center gap-3 rounded-lg border-2 border-navy/20 bg-brass px-8 py-4 font-display text-lg font-bold text-white shadow-md transition-colors hover:bg-brass-dark sm:w-auto lg:hidden"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            Call {business.phone}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust / Stats Bar -->
  <section class="bg-navy text-white py-6 border-b-4 border-brass">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
      {stats.map((s) => (
        <div>
          <p class="font-display font-black text-2xl sm:text-3xl text-brass-light">{s.title}</p>
          <p class="text-xs sm:text-sm text-white/75 mt-0.5">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Core Services 3-Cards -->
  <section class="max-w-7xl mx-auto px-6 py-16 sm:py-20">
    <div class="text-center max-w-3xl mx-auto">
      <span class="font-display text-xs font-bold uppercase tracking-[0.2em] text-brass">What We Specialize In</span>
      <h2 class="mt-2 font-display font-black text-3xl sm:text-4xl text-navy">
        High-Definition Custom Printing Solutions
      </h2>
      <p class="mt-3 text-navy/70 text-lg">
        State-of-the-art digital printing, heat press, and sublimation technology designed for vibrant color fidelity and maximum durability.
      </p>
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-3">
      {services.map((s) => (
        <a href={s.link} class="hp-lift group bg-white rounded-3xl border border-navy/10 p-8 shadow-sm hover:shadow-xl hover:border-brass/40 flex flex-col transition-all">
          <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-navy text-brass-light mb-6 group-hover:scale-110 transition-transform">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
          </div>
          <h3 class="font-display font-bold text-2xl text-navy group-hover:text-water transition-colors">{s.title}</h3>
          <p class="mt-3 text-navy/70 flex-1 leading-relaxed">{s.desc}</p>
          <span class="mt-6 font-display font-bold text-water group-hover:text-navy text-sm inline-flex items-center gap-1">
            Explore service →
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- All Services Grid -->
  <section class="bg-cream border-y border-navy/10 py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
        <div>
          <span class="font-display text-xs font-bold uppercase tracking-[0.2em] text-brass">Full Catalog</span>
          <h2 class="mt-1 font-display font-black text-3xl text-navy">All Printing Services</h2>
        </div>
        <a href="/services" class="font-display font-bold text-water hover:text-navy text-sm">
          View all services catalog →
        </a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {serviceLinks.map((svc) => (
          <a href={`/services/${svc.id}`} class="hp-lift bg-white rounded-2xl border border-navy/10 p-6 shadow-sm hover:border-brass/40 hover:shadow-md flex flex-col">
            <h3 class="font-display font-bold text-lg text-navy">{svc.data.h1}</h3>
            <p class="mt-2 text-xs text-navy/65 line-clamp-2 flex-1">{svc.data.summary}</p>
            <span class="mt-4 font-display font-semibold text-xs text-water">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Pain Points / Why Choose Us -->
  <section class="max-w-7xl mx-auto px-6 py-20">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <span class="font-display text-xs font-bold uppercase tracking-[0.2em] text-brass">The Albran Difference</span>
        <h2 class="mt-2 font-display font-black text-3xl sm:text-4xl text-navy leading-tight">
          Why Houston Businesses &amp; Creators Trust Us
        </h2>
        <p class="mt-4 text-navy/75 text-lg leading-relaxed">
          We combine cutting-edge commercial printing hardware with personalized attention. We inspect every graphic file, calibrate color profiles, and ensure your products exceed expectations.
        </p>

        <div class="mt-8 space-y-4">
          {painPoints.map((p) => (
            <div class="flex items-start gap-3">
              <div class="h-6 w-6 rounded-full bg-water/15 text-water flex items-center justify-center shrink-0 mt-0.5">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <p class="text-navy/85 font-medium">{p}</p>
            </div>
          ))}
        </div>

        <div class="mt-8">
          <ScheduleButton class="px-8 py-4 text-lg" label="Start Your Project Today" />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        {projects.map((p) => (
          <div class="hp-zoom rounded-2xl overflow-hidden shadow-md border border-navy/10">
            <img src={p.src} alt={p.alt} width="400" height="300" loading="lazy" class="w-full h-48 sm:h-56 object-cover" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Google Reviews -->
  <Reviews />

  <!-- Blog Teaser (Dynamically rendered from Headless CMS API) -->
  {featuredPosts.length > 0 && (
    <section class="max-w-7xl mx-auto px-6 py-20">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="font-display text-xs font-bold uppercase tracking-[0.2em] text-brass">Tips &amp; Guides</span>
          <h2 class="mt-1 font-display font-black text-3xl sm:text-4xl text-navy">Printing &amp; Sublimation Blog</h2>
          <p class="mt-2 text-navy/70">Expert advice on fabrics, color management, and marketing collateral.</p>
        </div>
        <a href="/blog" class="font-display font-bold text-water hover:text-navy text-base">
          Read all articles →
        </a>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        {featuredPosts.map((p) => {
          const formattedDate = formatPostDate(p.published_at);
          return (
            <article class="hp-lift group bg-white rounded-2xl border border-navy/10 overflow-hidden shadow-sm hover:shadow-xl flex flex-col transition-all">
              <a href={`/blog/${p.slug}`} class="hp-zoom block relative aspect-[16/10] bg-navy-800/5 overflow-hidden">
                <img
                  src={p.featured_image_url || "/images/placeholder.jpeg"}
                  alt={p.title}
                  width="600"
                  height="375"
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  onerror="this.onerror=null;this.src='/images/placeholder.jpeg';"
                />
              </a>
              <div class="p-6 flex flex-col flex-1">
                {formattedDate && (
                  <div class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-brass mb-3">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
                      <line x1="16" x2="16" y1="2" y2="6" />
                      <line x1="8" x2="8" y1="2" y2="6" />
                      <line x1="3" x2="21" y1="10" y2="10" />
                    </svg>
                    <time datetime={p.published_at ?? ""}>{formattedDate}</time>
                  </div>
                )}
                <h3 class="font-display font-bold text-xl text-navy group-hover:text-water transition-colors leading-snug">
                  <a href={`/blog/${p.slug}`}>{p.title}</a>
                </h3>
                {p.excerpt && (
                  <p class="mt-3 text-sm text-navy/70 flex-1 line-clamp-3 leading-relaxed">{p.excerpt}</p>
                )}
                <div class="mt-6 pt-4 border-t border-navy/5 flex items-center justify-between">
                  <a href={`/blog/${p.slug}`} class="font-display font-bold text-sm text-water hover:text-navy">
                    Read article →
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  )}

  <!-- Bottom CTA Banner -->
  <section class="bg-navy text-white py-16 px-6 border-t-4 border-brass">
    <div class="max-w-4xl mx-auto text-center">
      <span class="font-display text-xs font-bold uppercase tracking-[0.2em] text-brass-light">Ready to Get Started?</span>
      <h2 class="mt-2 font-display font-black text-3xl sm:text-4xl">
        Request Your Free Custom Print Quote
      </h2>
      <p class="mt-3 text-white/80 text-lg max-w-xl mx-auto">
        Fast turnarounds, crystal-clear color fidelity, and local service right here in Houston.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={business.phoneHref}
          class="hp-lift inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-xl bg-brass px-8 py-4 font-display text-lg font-bold text-white shadow-lg hover:bg-brass-dark transition-colors"
        >
          Call {business.phone}
        </a>
        <ScheduleButton class="w-full sm:w-auto px-8 py-4 text-lg" label="Request a Quote Online" />
      </div>
    </div>
  </section>
</BaseLayout>
