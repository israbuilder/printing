---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import ScheduleButton from "../../components/ScheduleButton.astro";
import { business } from "../../data/business";
import { getPostBySlug, formatPostDate, normalizeHtmlContent, type Post } from "../../lib/blog-api";

interface Props {
  post?: Post;
}
let { post } = Astro.props as Props;
const { slug } = Astro.params;

if (!post && slug) {
  const fetched = await getPostBySlug(slug);
  if (fetched) {
    post = fetched;
  }
}

if (!post) {
  return Astro.redirect("/404");
}

const FALLBACK_IMAGE = "/images/placeholder.jpeg";
const featuredImage = post.featured_image_url || FALLBACK_IMAGE;
const formattedDate = formatPostDate(post.published_at);

// SEO dinámico
const metaTitle = (post.seo?.meta_title ?? post.title).trim();
const seoTitle = `${metaTitle} | ${business.name}`;
const seoDescription = (
  post.seo?.meta_description ??
  post.excerpt ??
  `${post.title} — ${business.name}.`
).trim();

// Structured Data JSON-LD
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: seoDescription,
  ...(post.published_at ? { datePublished: post.published_at } : {}),
  ...(post.updated_at ? { dateModified: post.updated_at } : {}),
  image: featuredImage.startsWith("http") ? featuredImage : `${business.url}${featuredImage}`,
  author: {
    "@type": "Organization",
    name: business.name,
    url: business.url,
  },
  publisher: {
    "@type": "Organization",
    name: business.name,
    logo: {
      "@type": "ImageObject",
      url: `${business.url}${business.logo}`,
    },
  },
  mainEntityOfPage: `${business.url}/blog/${post.slug}`,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Inicio",
      item: business.url,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: `${business.url}/blog`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: post.title,
      item: `${business.url}/blog/${post.slug}`,
    },
  ],
};

const jsonLd = [articleSchema, breadcrumbSchema];
---
<BaseLayout
  title={seoTitle}
  description={seoDescription}
  path={`/blog/${post.slug}`}
  image={featuredImage}
  ogType="article"
  jsonLd={jsonLd}
>
  <!-- Header con Breadcrumbs -->
  <section class="bg-navy text-white border-b-4 border-brass">
    <div class="max-w-4xl mx-auto px-6 py-12 sm:py-16">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex flex-wrap items-center gap-2 text-xs font-semibold text-white/70">
          <li>
            <a href="/" class="hover:text-brass-light transition-colors">Inicio</a>
          </li>
          <li aria-hidden="true" class="text-white/40">/</li>
          <li>
            <a href="/blog" class="hover:text-brass-light transition-colors">Blog</a>
          </li>
          <li aria-hidden="true" class="text-white/40">/</li>
          <li class="text-brass-light truncate max-w-[200px] sm:max-w-md" aria-current="page">
            {post.title}
          </li>
        </ol>
      </nav>
      <h1 class="hp-rise font-display font-black text-3xl sm:text-4xl md:text-5xl leading-tight">
        {post.title}
      </h1>
      <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-white/80">
        {formattedDate && (
          <div class="flex items-center gap-1.5 font-medium text-brass-light">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
              <line x1="16" x2="16" y1="2" y2="6" />
              <line x1="8" x2="8" y1="2" y2="6" />
              <line x1="3" x2="21" y1="10" y2="10" />
            </svg>
            <time datetime={post.published_at ?? ""}>{formattedDate}</time>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Cuerpo del Post -->
  <article class="mx-auto max-w-4xl px-6 py-12">
    {post.featured_image_url && (
      <div class="mb-10 rounded-2xl overflow-hidden shadow-lg border border-navy/10 bg-navy/5">
        <img
          src={post.featured_image_url}
          alt={post.title}
          width="1200"
          height="675"
          loading="eager"
          class="w-full max-h-[500px] object-cover"
          onerror={`this.onerror=null;this.src='${FALLBACK_IMAGE}';`}
        />
      </div>
    )}
    {post.excerpt && (
      <p class="text-xl font-medium leading-relaxed text-navy/85 border-l-4 border-water pl-5 py-1 mb-8 italic">
        {post.excerpt}
      </p>
    )}
    {post.content ? (
      <div class="prose max-w-none text-navy/90" set:html={normalizeHtmlContent(post.content)} />
    ) : (
      <p class="text-navy/70 italic">No hay contenido disponible para este post.</p>
    )}
    <div class="mt-12 pt-6 border-t border-navy/10">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 font-display font-bold text-water hover:text-navy transition-colors text-base"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        Volver a todos los artículos
      </a>
    </div>
  </article>
</BaseLayout>
